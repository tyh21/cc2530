/**
 * @file    main.c
 * @brief   LG213 NFC 诊断 v3 (含上拉自检)
 */
#include <ioCC2530.h>
#include "epd2in9.h"
#include "nfc.h"

static void clock_init(void) {
    CLKCONCMD &= ~0x40;
    while (CLKCONSTA & 0x40) ;
    CLKCONCMD &= ~0x47;
}

static void wait_1s(void) {
    uint16 i, j;
    for (i=0;i<40;i++) for (j=0;j<16000;j++) ;
}

static char g_last[NFC_TEXT_MAX];

static uint8 str_diff(const char *a, const char *b) {
    while (*a && *b) { if (*a != *b) return 1; a++; b++; }
    return (*a != *b) ? 1 : 0;
}

/* 上拉自检: 把 SDA/SCL 设输入, 读电平 */
static uint8 bus_idle_level(void) {
    uint8 lv = 0;
    volatile uint16 d;
    P0SEL &= ~0x03;
    P0DIR &= ~0x03;      /* SDA/SCL 输入 */
    P0INP &= ~0x03;      /* 上拉 */
    P2INP &= ~0x20;      /* P0 上拉方向 (0=上拉) */
    for (d=0; d<5000; d++) ;   /* 等稳定 */
    if (P0_0) lv |= 0x01;   /* SDA=1 */
    if (P0_1) lv |= 0x02;   /* SCL=1 */
    return lv;
}

static void show_diag(uint8 rc, uint8 idle) {
    char line[40];
    EPD_Init();
    EPD_FrameClear(0xFF);
    line[0]='r'; line[1]='c'; line[2]='=';
    line[3]="0123456789ABCDEF"[rc & 0x0F];
    line[4]=' '; line[5]='I'; line[6]='=';
    line[7]="0123456789ABCDEF"[idle & 0x0F];
    line[8]=0;
    EPD_DrawString(6, 20, line, &Font16, 1);
    line[0]='W'; line[1]="0123456789ABCDEF"[g_nfc_ack_w & 0x0F];
    line[2]=' '; line[3]='R'; line[4]=(g_nfc_ack_r)?'1':'0';
    line[5]=' '; line[6]='S'; line[7]='=';
    line[8]="0123456789ABCDEF"[(g_nfc_status>>4)&0x0F];
    line[9]="0123456789ABCDEF"[g_nfc_status&0x0F];
    line[10]=0;
    EPD_DrawString(6, 50, line, &Font16, 1);
    EPD_ShowFrame();
    EPD_Sleep();
}

int main(void) {
    char buf[NFC_TEXT_MAX];
    uint8 rc, idle;
    uint8 i;

    clock_init();

    /* 上拉自检: 应读到 I=3 (SDA=1, SCL=1) */
    idle = bus_idle_level();

    rc = NFC_ReadText(buf, NFC_TEXT_MAX);

    /* 逐字节探测: 发 [AA][08][00][10][30], 看哪个 NACK */
    g_nfc_ack_w = NFC_ProbeSeq();

    show_diag(rc, idle);

    g_last[0] = 0;
    if (rc == NFC_OK) {
        for (i=0;i<NFC_TEXT_MAX;i++) g_last[i] = buf[i];
    }

    while (1) {
        rc = NFC_ReadText(buf, NFC_TEXT_MAX);
        if (rc == NFC_OK && str_diff(buf, g_last)) {
            for (i=0;i<NFC_TEXT_MAX;i++) g_last[i] = buf[i];
            EPD_Init();
            EPD_FrameClear(0xFF);
            EPD_DrawString(6, 40, buf, &Font16, 1);
            EPD_ShowFrame();
            EPD_Sleep();
        }
        wait_1s();
    }
}
