// C:\Users\tyh21\Desktop\cc2530\cc2530_RF_link\cc2530_LG290_nfc_mac\src\main.c
//    1 /**
//    2  * @file    main.c
//    3  * @brief   LG290 板 MN63Y1213 —— v9a 读写验证固件 (VDDEX 复位脉冲 + 延时双档)
//    4  *
//    5  * ============================================================================
//    6  * v7 实测: I2C 物理层完全不通(0 个真 ACK), 盲读全 FF
//    7  *
//    8  * v8 修复 (逆向原厂固件发现):
//    9  *   ★ 核心发现: 原厂固件(0xF586)在 I2C 通信前执行 VDDEX 复位脉冲:
//   10  *     SETB P2.3 → delay(5) → CLR P2.3 → delay(5) → SETB P2.3 → I2C
//   11  *   ★ 即 VDDEX 高→低→高的电源复位脉冲, 触发芯片内部 POR
//   12  *   ★ v5-v7 只做 低→高, 缺少高→低→高脉冲, 导致芯片 I2C 接口不响应
//   13  *   - I2C 位时序专用延时: 10us/20us → 3us/5us (原厂约 0.4us)
//   14  *   - 引脚配置一致: SDA=P0.0, SCL=P0.1, VDDEX=P2.3, P0DIR=输入(开漏)
//   15  *
//   16  * v9a 修正 (nfc.c): 延时双档分离 —— I2C 位时序 3/5us 专用,
//   17  *   通用 dly_s/dly_l 保持 10/20us (clock9_kind ACK 判定/引脚测量不受影响)
//   18  *
//   19  * v8 四屏验证流程 (每屏全刷, 停 5s):
//   20  *   1 ATTR    读 block 0(16B hex) —— 验证 I2C 是否打通
//   21  *   2 READ    读 NDEF 文本 —— 验证能否读回手机写入的内容
//   22  *   3 WRITE   写 NDEF "Hello CC2530!" —— 验证写入
//   23  *   4 VERIFY  读回验证 + 从地址探测 —— 写后读回确认
//   24  *
//   25  * ============================================================================
//   26  * v6 已诊断: 硬件 DC 层全干净(25kHz/上拉/去耦均 OK), 128 全 REAL 是假象,
//   27  *   盲读全 FF = 无设备响应。根因在软件:
//   28  *     1) cmd_send/resp_read 对每个字节要求 REAL, 多字节长帧必败
//   29  *     2) NDEF 按 Type 2 格式写到地址 0x0000, 覆盖了 Type 3 的 Attribute 块
//   30  *
//   31  * v7 已修复 (nfc.c):
//   32  *   - cmd_send: 从地址字节仍要求 REAL, 数据字节只要不是 NONE 就继续
//   33  *   - resp_read: 读取地址 ACK 只要不是 NONE 就继续
//   34  *   - ReadTextEx: 从 block 1(0x0010) 解析 NDEF, 跳过 block 0 Attribute
//   35  *   - WriteTextEx: 保护 block 0, NDEF 从 block 1 按块写, 更新 Attribute 长度字段
//   36  *
//   37  * v7 四屏验证流程 (每屏全刷, 停 5s):
//   38  *   1 ATTR    读 block 0(16B hex) —— 验证 I2C 是否打通
//   39  *   2 READ    读 NDEF 文本 —— 验证能否读回手机写入的内容
//   40  *   3 WRITE   写 NDEF "Hello CC2530!" —— 验证写入
//   41  *   4 VERIFY  读回验证 + 从地址探测 —— 写后读回确认
//   42  *
//   43  * ★ 从地址: 先试 0x54(手册默认), 不行试 0x55(原厂固件值)
//   44  * ★ 画屏前 NFC_PowerOff() 不必要(I2C 与 EPD 引脚不冲突), 但读写后断电更安全
//   45  * ============================================================================
//   46  */
