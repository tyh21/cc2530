//  894 /* --------------------------------------------------------- NDEF 解析 ------- */
//  895 /*
//  896  * ★★ v7: MN63Y1213 是 NFC Forum Type 3 Tag (FeliCa) ★★
//  897  *   实测(NFC Tools HEX 转储):
//  898  *     Block0 (0x0000) = Attribute 块, 16 字节:
//  899  *       [0]    Ver  (0x10 = 1.0)
//  900  *       [1]    Nbr  (一次可读块数, 实测 0x01)
//  901  *       [2]    Nbw  (一次可写块数, 实测 0x01)
//  902  *       [3..5] 保留 0
//  903  *       [6..7] NmaxB (最大块数? 实测 0x0002)
//  904  *       [8..9] 保留 0
//  905  *       [10]   WrFlag(写标志, 0x00=可写; 0xFF=只读)
//  906  *       [11]   WrFlag2
//  907  *       [12..13] NdefDataLen (NDEF 数据长度, 实测 0x0017 = 23)
//  908  *       [14..15] Ln (总长度含属性? 实测 0x002B = 43)
//  909  *     Block1.. (0x0010..) = NDEF 记录 (从 block 1 开始!)
//  910  *       D1 01 paylen 54 02 65 6E <text...>
//  911  *       D1 = TNF=well-known | MB=1 | ME=1 | SR=1 | CF=0
//  912  *       01 = TypeLen=1, paylen = PayloadLen, 54='T', 02=Status(lang=en)
//  913  *   ★ 根因: 旧代码把 NDEF 记录直接写到地址 0x0000, 覆盖了 Attribute 块,
//  914  *     导致手机读到属性错乱("可写:不")、CC2530 自己也读不回。
//  915  *   ★ 修复: 写时保护 block 0, NDEF 从 block 1(0x0010) 写起; 读时从 block 1 解析。
//  916  */

        RSEG NEAR_CODE:CODE:NOROOT(0)
