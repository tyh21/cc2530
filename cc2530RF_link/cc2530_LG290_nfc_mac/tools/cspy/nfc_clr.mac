__var n_main, n_at;
execUserSetup() { __message ">>> nfc_clr.mac\n"; }
execUserReset() { __setCodeBreak("0x1086", 0, "on_main()", "TRUE", ""); }
on_main()
{
  n_main = n_main + 1;
  __message "[clr] MAIN #", n_main, "\n";
  __clearCodeBreak("0x1086");
  __setCodeBreak("0x0EAB", 0, "on_at()", "TRUE", "");
}
on_at() { n_at = n_at + 1; if(n_at <= 5) __message "[clr] AUTOTUNE #", n_at, "\n"; }
