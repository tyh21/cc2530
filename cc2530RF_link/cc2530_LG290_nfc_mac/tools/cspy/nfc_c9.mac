/*
 * nfc_c9.mac — 在 clock9_kind 的 4 个采样点处断点, 看每个点的 SCL/SDA 电平
 *
 * clock9_kind = 0x26B6, 指令序列(手工数):
 *   0x26B6 MOV A,#-0x6              2B  00 01
 *   0x26B8 LCALL ?FUNC_ENTER_PDATA  3B  02 03 04
 *   0x26BB LCALL sda_rel             3B  05 06 07
 *   0x26BE LCALL scl_low             3B  08 09 0A
 *   0x26C1 LCALL dly_l               3B  0B 0C 0D
 *   0x26C4 LCALL sda_rd              3B  0E 0F 10
 *   0x26C7 MOV A,R1                 2B  11 12     <- pre 采样完
 *   0x26C9 MOV ?V0,A                2B  13 14
 *   0x26CB LCALL scl_hi              3B  15 16 17
 *   0x26CE LCALL sda_rd              3B  18 19 1A
 *   0x26D1 MOV A,R1                 2B  1B 1C     <- early 采样完
 *   0x26D3 MOV R7,A                 2B  1D 1E
 *   0x26D5 LCALL dly_l               3B  1F 20 21
 *   0x26D8 LCALL sda_rd              3B  22 23 24
 *   0x26DB MOV A,R1                 2B  25 26     <- late 采样完
 *   0x26DD MOV R6,A                 2B  27 28
 *
 * 但因为 FUNC_ENTER 等实际字节数不确定, 这里改为:
 *   只打一个断点在 0x26D1 (early 采样完), 一个在 0x26DB (late 采样完)。
 * 若地址不准命中不到, 就用 "函数入口 + 循环命中计数" 的粗粒度方案。
 *
 * 稳妥做法: 只断在函数入口, 记录 4 次命中为一组, 每次读 SFR 电平。
 * 由于每次命中都在入口(还没采样), 看不到采样值 —— 但能看到进入时的电平,
 * 可推断"上一轮结束时两根线的状态"。
 *
 * 这里先试精确地址 0x26D1 / 0x26DB。
 */

__var n;

execUserSetup()
{
  __message ">>> nfc_c9.mac: break @ 0x26D1 (after 'early' sample)\n";
  __setCodeBreak("0x26D1", 0, "on_early()", "TRUE", "");
}

on_early()
{
  n = n + 1;
  if(n <= 20)
  {
    __message "[", n, "] PC=0x", #PC:%X,
              " P0=0x", __readMemory8(0x80,"SFR"):%X,
              " P0DIR=0x", __readMemory8(0xFD,"SFR"):%X, "\n";
  }
}
