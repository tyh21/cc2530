/*
 * nfc_stream.mac — 只看流式消息, 不信 execUserExit 的计数
 * 断点 <=2 个 (CC2530 硬件断点少)
 *   0x0EAB autotune
 *   0x2961 NFC_ReadMem
 * 每次命中都打印 (前 30 次), 用序号自己数。
 */
__var c_at, c_rm;

execUserSetup()
{
  __message ">>> nfc_stream.mac armed (autotune + ReadMem)\n";
  __setCodeBreak("0x0EAB", 0, "on_at()", "TRUE", "");
  __setCodeBreak("0x2961", 0, "on_rm()", "TRUE", "");
}

on_at()
{
  c_at = c_at + 1;
  if(c_at <= 5) __message "AT #", c_at, "\n";
}

on_rm()
{
  c_rm = c_rm + 1;
  if(c_rm <= 30) __message "   RM #", c_rm, "\n";
}
