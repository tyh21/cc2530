/*
 * nfc_min.mac — 最小验证: 只设一个 autotune 断点, 确认 autotune 是否被进入
 */
__var c;

execUserSetup()
{
  __message ">>> nfc_min.mac armed\n";
  __setCodeBreak("0x0EAB", 0, "on_at()", "TRUE", "");
}

on_at()
{
  c++;
  if(c <= 3) __message "*** autotune entered #", c, "\n";
}

execUserExit()
{
  __message "\n===== MIN SUMMARY =====\n";
  __message "  autotune = ", c, "\n";
  __message "========================\n";
}
