/*
 * nfc_result.mac — 在 autotune 结束后读 g_at_ok 等结果
 *
 * 技巧: 断点停在 EPD_Init (0x3E49, autotune 之后),
 *       在断点回调里 XDATA 读不了 —— 但可以在 execUserExit() 里读!
 *       execUserExit 在 CSpyBat 退出前被调用, 此时目标仍处于停止态,
 *       上下文允许访问 XDATA。
 *
 * g_at_ok      = 0x1C3D
 * g_at_swap    = 0x1C3E
 * g_at_us      = 0x1C3F
 * g_at_ver     = 0x1C40
 * g_at_perfect = 0x1C69
 */

__var hit;

execUserSetup()
{
  __message ">>> nfc_result.mac: break @ EPD_Init (0x3E49)\n";
  __setCodeBreak("0x3E49", 0, "on_epd()", "TRUE", "");
}

on_epd()
{
  hit = hit + 1;
  if(hit <= 3)
  {
    __message "[", hit, "] reached EPD_Init (autotune done)\n";
  }
}

execUserExit()
{
  __message "\n===== READING RESULTS (XDATA) =====\n";
  __message "  g_at_ok      = ", __readMemory8(0x1C3D, "XDATA"), "\n";
  __message "  g_at_swap    = ", __readMemory8(0x1C3E, "XDATA"), "\n";
  __message "  g_at_us      = ", __readMemory8(0x1C3F, "XDATA"), "\n";
  __message "  g_at_ver     = 0x", __readMemory8(0x1C40, "XDATA"):%X, "\n";
  __message "  g_at_perfect = ", __readMemory8(0x1C69, "XDATA"), "\n";
  __message "===================================\n";
}
