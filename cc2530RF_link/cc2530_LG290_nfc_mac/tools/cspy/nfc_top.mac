/*
 * nfc_top.mac — 顶层读 IDATA (不在断点回调里, 应该允许)
 *
 * 思路:
 *   execUserSetup 里设一个断点 (回调为空, 只为了"停住")
 *   断点命中后 C-SPY 停下, 此时 execUserSetup 已返回,
 *   目标处于停止态 —— 若 CSpyBat 在停止态还有机会执行宏...
 *
 * 若这条路也不通, 就说明 CSpyBat 批处理模式下每次命中都会走回调。
 * 那就改用 "回调内只读 SFR" 的方案 (已经验证可读)。
 */

__var n;

execUserSetup()
{
  __message ">>> nfc_top.mac armed\n";
  __setCodeBreak("0x2670", 0, "on_ack()", "TRUE", "");
}

on_ack()
{
  n = n + 1;
  /* 只读 SFR —— 已验证在回调里可读 */
  __message "[", n, "] PC=0x", #PC:%X,
            " P0=0x", __readMemory8(0x80,"SFR"):%X,
            " P0DIR=0x", __readMemory8(0xFD,"SFR"):%X, "\n";
}
