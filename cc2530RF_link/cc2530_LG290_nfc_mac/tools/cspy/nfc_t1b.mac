/* 单断点 @ t1_wait_ticks 自旋循环 (0x1FC7): 读 T1CNTL/E2 T1CNTH/E3, 看是否递增 */
__var c;
__var l0h, l0l, first;
execUserSetup() { __message ">>> t1b armed\n"; }
execUserReset() {
  __message ">>> arm @0x1FC7 (spin loop)\n";
  __setCodeBreak("0x1FC7", 0, "on_t()", "TRUE", "");
}
on_t() {
  c = c + 1;
  if(c <= 8) {
    __message "spin#", c,
      " T1L=", __readMemory8(0xE2,"SFR"):%X,
      " T1H=", __readMemory8(0xE3,"SFR"):%X,
      " T1CTL=", __readMemory8(0xE4,"SFR"):%X,
      " CLKCONSTA=", __readMemory8(0x9E,"SFR"):%X, "\n";
  }
}
