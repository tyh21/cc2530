/* nfc_2bp.mac — 测 2 断点上限 */
__var c_at, c_pu;
execUserSetup()
{
  __message ">>> nfc_2bp.mac armed\n";
  __setCodeBreak("0x0EAB", 0, "on_at()", "TRUE", "");
  __setCodeBreak("0x246D", 0, "on_pu()", "TRUE", "");
}
on_at() { c_at++; if(c_at<=2) __message "> autotune #", c_at, "\n"; }
on_pu() { c_pu++; if(c_pu<=30) __message "  pwrUp #", c_pu, "\n"; }
execUserExit()
{
  __message "\n===== 2BP SUMMARY =====\n";
  __message "  autotune = ", c_at, "\n";
  __message "  pwrUp    = ", c_pu, "\n";
  __message "========================\n";
}
