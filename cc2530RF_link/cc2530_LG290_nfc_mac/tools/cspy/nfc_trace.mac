/*
 * nfc_trace.mac — 跟踪 tx_byte_ack (0x2707) 的返回值, 判断 autotune 每步结果
 *
 * tx_byte_ack 里: i2c_tx8 -> i2c_read_ack
 * 返回 R1: 0(=NFC_ACK_REAL/ACK) 或 1(=NFC_ACK_NONE/NACK)
 * 但注意它 return 前会 MOV R1,#0x1 或 #0x0 然后 RET。
 * 所以断点在 i2c_read_ack (0x2670) 入口更能看到“这次是哪个 swap”。
 *
 * 这里: 断点打在 tx_byte_ack 入口, 记录 P0DIR(判断 swap) + 调用时的 P0。
 * 同时也断 i2c_read_ack 采集点 0x2682 记录 SDA。
 */

__var n, m, p0, dir;

execUserSetup()
{
  __message ">>> nfc_trace.mac: break tx_byte_ack@0x2707 + sample@0x2682\n";
  __setCodeBreak("0x2707", 0, "on_tx()", "TRUE", "");
  __setCodeBreak("0x2682", 0, "on_smp()", "TRUE", "");
}

on_tx()
{
  n = n + 1;
  if(n <= 40)
  {
    dir = __readMemory8(0xFD,"SFR");
    p0  = __readMemory8(0x80,"SFR");
    __message "TX#", n, " P0DIR=0x", dir:%X, " P0=0x", p0:%X,
              (dir==0x02)?"  [swap=0]":"", (dir==0x01)?"  [swap=1]":"", "\n";
  }
}

on_smp()
{
  m = m + 1;
  if(m <= 40)
  {
    dir = __readMemory8(0xFD,"SFR");
    p0  = __readMemory8(0x80,"SFR");
    __message "  SMP#", m, " P0DIR=0x", dir:%X, " SDA=", (p0&1)?1:0,
              (dir==0x02)?"  [swap=0]":"", (dir==0x01)?"  [swap=1]":"", "\n";
  }
}
