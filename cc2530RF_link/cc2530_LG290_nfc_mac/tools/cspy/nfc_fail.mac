/*
 * nfc_fail.mac — 定位 NFC_ReadMem 的具体失败出口 (v20)
 *
 * i2c_write_cmd = 0x288F, i2c_read_cmd = 0x2906
 * 失败出口 (LCALL i2c_stop 的地址):
 *   0x28AC  write_cmd: 写"从地址字节"(slv<<1 & 0xFE) 未获 ACK
 *   0x28BE  write_cmd: 写"块地址字节" 未获 ACK
 *   0x28EB  write_cmd: 写"数据字节" 未获 ACK
 *   0x2923  read_cmd : 读"从地址字节"(slv<<1 | 1) 未获 ACK
 *
 * 每次命中打印一个字符, 跑完看哪一类失败最多。
 * 同时在 i2c_read_ack 采样点 (v20 = 0x26B4, LCALL sda_rd) 读 P0/P0DIR。
 * (注意: 回调里 XDATA 不可读, 但 SFR 可读)
 *   P0DIR=0x02 -> swap=0 (SDA=P0.0/SCL=P0.1: SDA 输入时 DIR bit0 清 0)
 *   P0DIR=0x01 -> swap=1 (SDA=P0.1/SCL=P0.0: SDA 输入时 DIR bit1 清 0)
 */

__var f1, f2, f3, f4;
__var sa, sd;

execUserSetup()
{
  __message ">>> nfc_fail.mac armed (v20)\n";
  __setCodeBreak("0x28AC", 0, "on_f1()", "TRUE", "");
  __setCodeBreak("0x28BE", 0, "on_f2()", "TRUE", "");
  __setCodeBreak("0x28EB", 0, "on_f3()", "TRUE", "");
  __setCodeBreak("0x2923", 0, "on_f4()", "TRUE", "");
  __setCodeBreak("0x26B4", 0, "on_sm()", "TRUE", "");   /* v20 采样点 */
}

on_f1() { f1++; if(f1<=4) __message "  [W1] write ADDR nak  #", f1, "\n"; }
on_f2() { f2++; if(f2<=4) __message "  [W2] write BLK  nak  #", f2, "\n"; }
on_f3() { f3++; if(f3<=4) __message "  [W3] write DATA nak  #", f3, "\n"; }
on_f4() { f4++; if(f4<=4) __message "  [R1] read  ADDR nak  #", f4, "\n"; }

on_sm()
{
  sa++;
  if(sa <= 24)
  {
    /* P0=0x80(脚值)  P0DIR=0xFD(方向) */
    __message "  smp#", sa, " P0=", __readMemory8(0x80,"SFR"):%X,
              " DIR=", __readMemory8(0xFD,"SFR"):%X, "\n";
  }
}

execUserExit()
{
  __message "\n===== FAIL EXIT SUMMARY =====\n";
  __message "  W1 (write addr nak) = ", f1, "\n";
  __message "  W2 (write blk  nak) = ", f2, "\n";
  __message "  W3 (write data nak) = ", f3, "\n";
  __message "  R1 (read  addr nak) = ", f4, "\n";
  __message "  samples @0x26B4     = ", sa, "\n";
  __message "=============================\n";
}
