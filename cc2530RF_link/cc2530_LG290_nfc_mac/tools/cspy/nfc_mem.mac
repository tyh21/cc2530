/* 在断点回调里试读各种空间 (main 停住时) */
execUserSetup() { }
execUserReset() { __setCodeBreak("0x1086", 0, "on_m()", "TRUE", ""); }
on_m() {
  __message "SP=", __readMemory8(0x81,"SFR"):%X, "\n";
  __message "IDATA 0x8F = ", __readMemory8(0x8F,"IDATA"):%X, "\n";
  __message "DATA  0x8F = ", __readMemory8(0x8F,"DATA"):%X, "\n";
  __message "XDATA 0x1C6A = ", __readMemory8(0x1C6A,"XDATA"):%X, "\n";
  __message "BITS 0x30 = ", __readMemory8(0x30,"BITS"):%X, "\n";
}
