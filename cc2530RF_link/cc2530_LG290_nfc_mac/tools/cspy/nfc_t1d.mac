execUserSetup() { }
execUserReset() { __setCodeBreak("0x2033", 0, "on_x()", "TRUE", ""); }  /* TimebaseCal entry */
on_x() {
  __message "TimebaseCal entry: T1CTL=", __readMemory8(0xE4,"SFR"):%X,
   " T1H=", __readMemory8(0xE3,"SFR"):%X, " T1L=", __readMemory8(0xE2,"SFR"):%X,
   " CLKCONSTA=", __readMemory8(0x9E,"SFR"):%X, "\n";
}
