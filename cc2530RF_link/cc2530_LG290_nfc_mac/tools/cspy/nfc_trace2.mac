/*
 * nfc_trace2.mac — v20 调用轨迹 (确认 autotune 到底跑到哪)
 *
 * 地址 (v20 project.map):
 *   autotune            0x0EAB
 *   NFC_SetSwap         0x2757
 *   NFC_SetBitUs        ?    (查 map)
 *   NFC_PowerOff        ?
 *   NFC_PowerUp         0x246D
 *   NFC_BusRecover      ?
 *   NFC_Probe           0x311A
 *   NFC_ReadMem         0x2961
 *   i2c_write_cmd       0x288F
 *   i2c_read_cmd        0x2906
 *   i2c_read_ack        0x26A0
 */

__var c_autotune, c_setswap, c_pwrup, c_probe, c_readmem, c_wc, c_rc, c_rac;

execUserSetup()
{
  __message ">>> nfc_trace2.mac armed (v20)\n";
  __setCodeBreak("0x0EAB", 0, "on_at()",  "TRUE", "");
  __setCodeBreak("0x2757", 0, "on_ss()",  "TRUE", "");
  __setCodeBreak("0x246D", 0, "on_pu()",  "TRUE", "");
  __setCodeBreak("0x311A", 0, "on_pr()",  "TRUE", "");
  __setCodeBreak("0x2961", 0, "on_rm()",  "TRUE", "");
  __setCodeBreak("0x288F", 0, "on_wc()",  "TRUE", "");
  __setCodeBreak("0x2906", 0, "on_rc()",  "TRUE", "");
  __setCodeBreak("0x26A0", 0, "on_ra()",  "TRUE", "");
}

on_at() { c_autotune++; if(c_autotune<=2) __message "> autotune\n"; }
on_ss() { c_setswap++;  if(c_setswap<=20) __message "  setSwap\n"; }
on_pu() { c_pwrup++;    if(c_pwrup<=20)   __message "  pwrUp\n"; }
on_pr() { c_probe++;    if(c_probe<=20)   __message "    probe #", c_probe, "\n"; }
on_rm() { c_readmem++;  if(c_readmem<=20) __message "      ReadMem #", c_readmem, "\n"; }
on_wc() { c_wc++;       if(c_wc<=20)      __message "        writecmd #", c_wc, "\n"; }
on_rc() { c_rc++;       if(c_rc<=20)      __message "        readcmd  #", c_rc, "\n"; }
on_ra() { c_rac++; }

execUserExit()
{
  __message "\n===== TRACE2 SUMMARY =====\n";
  __message "  autotune  = ", c_autotune, "\n";
  __message "  setSwap   = ", c_setswap, "\n";
  __message "  pwrUp     = ", c_pwrup, "\n";
  __message "  probe     = ", c_probe, "\n";
  __message "  ReadMem   = ", c_readmem, "\n";
  __message "  writecmd  = ", c_wc, "\n";
  __message "  readcmd   = ", c_rc, "\n";
  __message "  read_ack  = ", c_rac, "\n";
  __message "==========================\n";
}
