/* run_and_read.mac — 让 CC2530 跑到 autotune 结束, 然后 dump 关键状态
 * 用法: CSpyBat ... --macro tools/cspy/run_and_read.mac
 * 目的: 非 GUI 地拿到 "为什么连不上 NFC" 的第一手读数
 */

/* 让目标全速运行一段, 让 main -> autotune() 执行完 */
execUserReset("__RESET__");

/* 断点设在 autotune 返回之后的 EPD_Init 之前, 这里已经是结论所在 */
/* main.c: autotune() 调用点之后紧接着 NFC_SetSwap/NFC_SetBitUs/EPD_Init */

__message "==== NFC DEBUG DUMP ====";

/* --- SFR 区: 引脚方向/输入模式/电平 --- */
__message "P0    = 0x", __sfrMemory(0x80), ":8X";
__message "P1    = 0x", __sfrMemory(0x90), ":8X";
__message "P2    = 0x", __sfrMemory(0xA0), ":8X";
__message "P0DIR = 0x", __sfrMemory(0xFD), ":8X";
__message "P1DIR = 0x", __sfrMemory(0xFE), ":8X";
__message "P2DIR = 0x", __sfrMemory(0xFF), ":8X";
__message "P0INP = 0x", __sfrMemory(0x8F), ":8X";
__message "P1INP = 0x", __sfrMemory(0xF6), ":8X";
__message "P2INP = 0x", __sfrMemory(0xF7), ":8X";
__message "P0SEL = 0x", __sfrMemory(0xF3), ":8X";
__message "P2SEL = 0x", __sfrMemory(0xF5), ":8X";

/* --- XDATA: autotune 结论 --- */
__message "g_at_ok   = ", __readMemory8(0x1C32, "XDATA");
__message "g_at_swap = ", __readMemory8(0x1C33, "XDATA");
__message "g_at_us   = ", __readMemory8(0x1C34, "XDATA");
__message "g_at_ver  = ", __readMemory8(0x1C35, "XDATA");

/* --- XDATA: 物理层自检 --- */
__message "g_ext_nib = ", __readMemory8(0x1C1D, "XDATA");
__message "g_off_nib = ", __readMemory8(0x1C1E, "XDATA");
__message "g_meas_us = ", __readMemory8(0x1C2F, "XDATA");
__message "g_scn_n   = ", __readMemory8(0x1C2B, "XDATA");

__message "==== END DUMP ====";

/* 读完就停, 不要继续跑 */
__message "Target left stopped.";
