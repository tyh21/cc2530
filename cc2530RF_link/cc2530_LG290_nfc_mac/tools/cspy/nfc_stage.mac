/*
 * nfc_stage.mac — 分级 arm (每级在目标已停止时设置下一级断点, 消除竞态)
 *
 * 级1: main(0x1086)       -> arm autotune
 * 级2: autotune(0x0EAB)   -> arm NFC_ReadMem
 * 级3: ReadMem(0x2961)    -> arm EPD_Init
 * 级4: EPD_Init(0x3E49)   -> 停住(autotune 已结束, 读 XDATA)
 */
__var n_main, n_at, n_rm, n_epd;

execUserSetup() { __message ">>> nfc_stage.mac\n"; }

execUserReset()
{
  __setCodeBreak("0x1086", 0, "on_main()", "TRUE", "");
}

on_main()
{
  n_main = n_main + 1;
  __message "[stage] MAIN #", n_main, " -> arm autotune\n";
  __setCodeBreak("0x0EAB", 0, "on_at()", "TRUE", "");
}

on_at()
{
  n_at = n_at + 1;
  __message "[stage] AUTOTUNE #", n_at, " -> arm ReadMem\n";
  __setCodeBreak("0x2961", 0, "on_rm()", "TRUE", "");
}

on_rm()
{
  n_rm = n_rm + 1;
  if(n_rm <= 20) __message "[stage]   READMEM #", n_rm, "\n";
}
