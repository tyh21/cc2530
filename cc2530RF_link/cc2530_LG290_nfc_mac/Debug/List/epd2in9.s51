//   89 void EPD_PowerOn(void)
EPD_PowerOn:
        CODE
//   90 {
        ; Saved register size: 0
        ; Auto size: 0
//   91     EPD_PWR = EPD_PWR_OFF_LVL;         /* 强制断电 */
        CLR       0x80.7
//   92     EPD_DelayMS(200);                  /* 放电: 让控制器彻底掉电复位 */
        ; Setup parameters for call to function EPD_DelayMS
        MOV       R2,#-0x38
        MOV       R3,#0x0
        LCALL     EPD_DelayMS
//   93     EPD_PWR = EPD_PWR_ON_LVL;          /* 上电 (原固件 0x11735) */
        SETB      0x80.7
//   94     EPD_DelayMS(100);                  /* 供电稳定 */
        ; Setup parameters for call to function EPD_DelayMS
        MOV       R2,#0x64
        MOV       R3,#0x0
        LCALL     EPD_DelayMS
//   95 }
        RET
        REQUIRE _A_P0
