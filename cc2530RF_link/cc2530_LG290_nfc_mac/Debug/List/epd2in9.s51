//  471     src  = (uint8)(EPD_LAND_H - 1 - y);
//  472     gate = x;
//  473 #endif
//  474 
//  475     idx = (uint16)(gate * EPD_LINE_BYTES) + (src >> 3);
        MOV       A,R0
        MOV       B,#0x10
        MUL       AB
        XCH       A,R0
        MOV       R2,B
        MOV       B,#0x0
        MUL       AB
        ADD       A,R2
        MOV       R2,A
        MOV       B,#0x10
        MOV       A,R1
        MUL       AB
        ADD       A,R2
        MOV       R1,A
        MOV       A,R6
