//  478         EPD_Frame[idx] &= (uint8)~mask;   /* 0=黑 */
        MOV       A,R2
        CPL       A
        MOV       R2,A
        MOV       A,#EPD_Frame & 0xff
        ADD       A,R0
        MOV       DPL,A
        MOV       A,#(EPD_Frame >> 8) & 0xff
        ADDC      A,R1
        MOV       DPH,A
        MOVX      A,@DPTR
        ANL       A,R2
        MOVX      @DPTR,A
        SJMP      ??EPD_SetPixel_0
//  479     else
