//  202 void NFC_T1Init(void)
NFC_T1Init:
        CODE
//  203 {
        REQUIRE ?V0
        REQUIRE ?V1
        REQUIRE ?V2
        REQUIRE ?V4
        REQUIRE ?V5
        MOV       A,#-0xb
        LCALL     ?FUNC_ENTER_PDATA
        ; Saved register size: 11
        ; Auto size: 0
//  204     /* ★ v10: 原厂固件写 CLKCONCMD=0x80. ★★ v24 更正其含义(查 TI 手册 SWRU191F):
//  205      *   0x80 = 0b1000_0000 => bit7 OSC32K=1 (选 32kHz **RCOSC**), bit6 OSC=0 (32MHz XOSC)。
//  206      *   也就是说原厂**不是**要切 16MHz! 它是选 32MHz XOSC + 把 32kHz 源设成 RCOSC。
//  207      *   之前以为"要切 16MHz RCOSC"、拿 CLKCONSTA.7 当 16M 标志, 全是误读。
//  208      *
//  209      * ★★ v22 现象(串口实测): 写 0x80 后轮询 `(CLKCONSTA & 0x80)` 会**死等** ——
//  210      *   因为该位是 OSC32K 状态, 芯片若没有 32kHz RC 或该位行为不同, 就永远等不到 1。
//  211      *   原厂轮询的其实也是这一位, 但原厂芯片上它能变 → 在**我们的板**上不行。
//  212      *
//  213      * ★★ v24 正确做法: **不要**再去动 32kHz 源(保持复位默认 OSC32K=1→按芯片实际),
//  214      *   只做两件确定的事:
//  215      *     ① 明确选 32MHz XOSC (清 bit6), 等 CLKCONSTA.6==0 变稳定;
//  216      *     ② TICKSPD/CLKSPD 清 0 → T1 与 CPU 都 32MHz。
//  217      *   T1 16 位 @32MHz → tick=31.25ns (tickNs≈31)。
//  218      *   32kHz 源/睡眠定时器是否能走, 由 TimebaseCal 实测(有超时, 不再死等)。 */
//  219     uint16 guard = 0u;
        MOV       R0,#0x0
        MOV       R1,#0x0
//  220     uint8  sta;
//  221 
//  222     g_t1ClkCmd0 = CLKCONCMD;           /* 切换前原值 */
        MOV       A,0xc6
        MOV       DPTR,#g_t1ClkCmd0
        MOVX      @DPTR,A
//  223 
//  224     /* ① 选 32MHz XOSC: 清 bit6(OSC), 等 CLKCONSTA.6 变 0 */
//  225     CLKCONCMD &= (uint8)~0x40u;        /* bit6 OSC=0 -> 32MHz XOSC */
        ANL       0xc6,#0xbf
        SJMP      ??NFC_T1Init_0
//  226     while (guard < 60000u) {
//  227         sta = CLKCONSTA;
//  228         if ((sta & 0x40u) == 0u) { break; }   /* CLKCONSTA.6=0: 已切到 32MHz XOSC */
//  229         guard++;
??NFC_T1Init_1:
        INC       R0
        MOV       A,R0
        JNZ       ??NFC_T1Init_0
        INC       R1
??NFC_T1Init_0:
        CLR       C
        MOV       A,R0
        SUBB      A,#0x60
        MOV       A,R1
        SUBB      A,#-0x16
        JNC       ??NFC_T1Init_2
        MOV       R2,0x9e+0x0
