// 1773     i2c_stop();
        ; Setup parameters for call to function i2c_stop
        LCALL     i2c_stop
// 1774     dly_l();
        ; Setup parameters for call to function dly_l
        LCALL     dly_l
// 1775     return 0u;
        MOV       R1,#0x0
??NFC_StatusRead_2:
