// 1833 
// 1834 /*
// 1835  * ★ v34 ACK 矩阵: 定位"首字节必 ACK"这个假象的触发条件。
// 1836  *   地址全扫描显示 128/128 都"有 ACK", 而当事物的第二个字节时恒为 NACK,
// 1837  *   说明判据被某个"首字节之后才成立"的因素污染了。本矩阵逐一剥离变量:
// 1838  *
// 1839  *   m[0] A: START + 发 0x00           -> 数据位全 0(SDA 会被驱低)
// 1840  *   m[1] B: START + 发 0xFF           -> 数据位全 1(SDA 全程高)
// 1841  *   m[2] C: START + 不发字节          -> 剥离"数据字节"这个变量
// 1842  *   m[3] D: 无 START + 不发字节        -> 再剥离 START
// 1843  *   m[4] E: START + 发 0xAA           -> 真实用的地址字节
// 1844  *   m[5] F: 同一事务里 AA 之后的 0x00  -> 已知的"NACK"对照
// 1845  *
// 1846  *   每个返回值是 3 点采样位图: bit0=抬时钟前(pre) bit1=时钟高中(hi) bit2=落以后(post)
// 1847  *   (置 1 = 读到高; hi=0 才是"看起来有 ACK", post=0 表示线被钉死)
// 1848  *
// 1849  *   判读:
// 1850  *     A/B 都为 ACK  -> 与字节值无关
// 1851  *     C 也为 ACK    -> 与有没有数据字节无关, 只跟 START 有关
// 1852  *     D 也为 ACK    -> 连 START 都无关 -> 是"连续两次采样"本身的系统偏差
// 1853  */
// 1854 /*
// 1855  * ★ v34 时序扫描: 验证"假 ACK"是否由**SCL 翻转本身**引起。
// 1856  *   rep[0] = G 情形: START + 8 个**不驱动 SDA** 的时钟 + ACK 槽
// 1857  *       若 G 也报"有 ACK", 则与发了什么字节完全无关 -> 纯由"翻转了 8 次 SCL"造成,
// 1858  *       属于电气假象(耦合/电荷积累), 总线上并没有器件在应答。
// 1859  *   rep[1..5] = START+AA 之后、抬第 9 时钟**之前**, 把 SDA 放开,
// 1860  *       分别等约 22 / 66 / 176 / 616 / 1716 us 后读 SDA 电平(1=高)。
// 1861  *       若越等越往上抬, 说明内部上拉太弱、还没来得及拉回高 -> 也是电气问题。
// 1862  */
// 1863 /* 前置原型: ADC 换算函数定义在后面的 v35 区块里 */
// 1864 static uint16 sda_adc_mv(void);
// 1865 
// 1866 /*
// 1867  * ★★ v36 引脚状态快照 ★★
// 1868  *   ADC 实测 SDA = 3.07V(远高于 VIH), 而同一时刻数字读值却是 0。
// 1869  *   说明问题不在电平, 而在"读那一位"这件事本身。本函数在同一时刻同时取:
// 1870  *     数字读值 / 真实电压 / 全部相关寄存器
// 1871  *   regs[0]=P0 regs[1]=P0DIR regs[2]=P0SEL regs[3]=P0INP regs[4]=P2INP regs[5]=APCFG
// 1872  *       regs[6]=swap01 regs[7]=sda_rd() 用的原始 P0 字节
// 1873  *   注意: 寄存器快照必须在调用 ADC **之前**抓, 因为 ADC 会动 APCFG/P0DIR。
// 1874  */
// 1875 /*
// 1876  * ★ v36 静态漏电观测: 上电后**一个时钟都不翻**, 直接放开 SDA,
// 1877  *   在 0 / 1ms / 5ms / 20ms 处同时取数字读值和真实电压。
// 1878  *   判读:
// 1879  *     全程稳定 3300mV 且数字=1 -> 静态时总线是好的, 问题只在"翻转几次时钟之后才出现"
// 1880  *                                 => 是芯片在事务中被拉低(ACK 保持 / 状态机), 加电阻也救不了
// 1881  *     一开始就飘在中间电平     -> 存在**静态**漏电通路需要外部上拉,
// 1882  *                                 内部 20k 上拉拉不动 -> 必须外接上拉电阻
// 1883  */

        RSEG NEAR_CODE:CODE:NOROOT(0)
