// 1946 
// 1947 /*
// 1948  * ★★ v35 ADC 实测 SDA 电压 ★★
// 1949  *   数字读值已经反复自相矛盾(128/128 全"ACK"、空时钟也"ACK"、放开后 1.7ms 回不到高),
// 1950  *   再靠读 0/1 推理没有意义 —— 必须知道**真实电压**。
// 1951  *   用 CC2530 自带 ADC 量 P0.0(SDA), AVDD(3.3V) 作参考, 12 位。
// 1952  *
// 1953  *   mv[0] = SDA 推挽驱高时的电压(基准, 应约 3300mV, 用来验证 ADC 本身没配错)
// 1954  *   mv[1] = SDA 放开(输入+内部上拉)静置后的电压 —— 总线空闲时的真实电平
// 1955  *   mv[2] = START + 8 个空时钟 之后、放开 SDA 的电压 —— "假ACK"现场
// 1956  *   mv[3] = 紧接着第 9 个时钟**抬高中**的 SDA 电压 —— 就是"ACK 采样点"
// 1957  *   mv[4] = 第 9 时钟**落下之后**的 SDA 电压 —— 解释为什么 post 会读到 1
// 1958  *
// 1959  *   判读(3.3V 系统, CC2530 VIH 约 2.0~2.3V, VIL 约 0.9V):
// 1960  *     ~3300mV -> 线确实是高的, 那"读到0"就是引脚/寄存器层面的问题(不是电平问题)
// 1961  *     ~0~400mV -> 有东西硬拉低 -> 外部\succ 上拉, 总线被占住
// 1962  *     ~1000~2000mV -> 落在判决门限附近的**不确定区**, 读到 0 还是 1 全看运气和残余电荷
// 1963  *                     => 这才是"时好时坏/128全ACK"的根因
// 1964  */

        RSEG NEAR_CODE:CODE:NOROOT(0)
// 1965 static uint16 sda_adc_mv(void)
sda_adc_mv:
        CODE
// 1966 {
        REQUIRE ?V0
        REQUIRE ?V1
        REQUIRE ?V2
        REQUIRE ?V3
        REQUIRE ?V4
        REQUIRE ?V5
        REQUIRE ?V6
        REQUIRE ?V7
        MOV       A,#-0xd
        LCALL     ?FUNC_ENTER_PDATA
        ; Saved register size: 13
        ; Auto size: 0
// 1967     uint16 v;
// 1968     uint8  dirsave = P0DIR;
        MOV       R3,0xfd+0x0
// 1969     uint8  inpsave = P0INP;               /* ★ v41a: 必须一并保存 */
        MOV       R2,0x8f+0x0
// 1970     uint16 guard;
// 1971 
// 1972     APCFG |= 0x01u;                       /* P0.0 -> 模拟输入 */
        ORL       0xf2,#0x1
// 1973     ADCCON3 = (uint8)(0xC0u | 0x30u | 0x00u);  /* AVDD 参考 | 512抽取(12bit) | AIN0 */
        MOV       0xb6,#-0x10
// 1974     /* ★ v41a: 加超时兜底 —— 万一 EOC 不置位, 绝不在这里死等 */
// 1975     for (guard = 0u; guard < 60000u; guard++) {
        MOV       R0,#0x0
        MOV       R1,#0x0
        SJMP      ??sda_adc_mv_0
??sda_adc_mv_1:
        INC       R0
        MOV       A,R0
        JNZ       ??sda_adc_mv_0
        INC       R1
??sda_adc_mv_0:
        CLR       C
        MOV       A,R0
        SUBB      A,#0x60
        MOV       A,R1
        SUBB      A,#-0x16
        JNC       ??sda_adc_mv_2
// 1976         if ((ADCCON1 & 0x80u) != 0u) { break; }
        MOV       A,0xb4
        MOV       C,0xE0 /* A   */.7
        JNC       ??sda_adc_mv_1
// 1977     }
// 1978     v = (uint16)((((uint16)(ADCH & 0x0Fu)) << 8) | ADCL);
??sda_adc_mv_2:
        MOV       A,0xbb+0x0
        MOV       R0,A
        MOV       R1,#0x0
        CLR       A
        XCH       A,R0
        MOV       R1,A
        MOV       A,R0
        ANL       A,#0x0
        MOV       R0,A
        MOV       A,R1
        ANL       A,#0xf
        MOV       R1,A
        MOV       A,0xba
        MOV       R4,A
        MOV       R5,#0x0
        MOV       A,R0
        ORL       A,R4
        MOV       ?V0,A
        MOV       A,R1
        ORL       A,R5
        MOV       ?V1,A
// 1979     /* ★ v41a: 完整还原 —— 原来漏了 P0INP, 会让 P0.0 的上拉保持在
// 1980      *   "模拟模式"遗留状态, 之后所有 sda_rd() 全部失真。 */
// 1981     APCFG &= (uint8)~0x01u;               /* 还原数字 IO */
        ANL       0xf2,#0xfe
// 1982     P0SEL &= (uint8)~0x01u;
        ANL       0xf3,#0xfe
// 1983     P0INP = inpsave;                      /* 还原上拉配置 */
        MOV       0x8f,R2
// 1984     P0DIR = dirsave;                      /* 还原方向(可能是 input) */
        MOV       0xfd,R3
// 1985     return (uint16)((v * 3300UL) / 4096UL);
        CLR       A
        MOV       ?V2,A
        MOV       ?V3,A
        MOV       DPTR,#__Constant_ce4
        MOV       R0,#?V4
        LCALL     ?L_MOV_X
        MOV       R0,#?V0
        MOV       R1,#?V4
        LCALL     ?L_MUL
        MOV       A,#0xc
        MOV       R0,#?V0
        LCALL     ?UL_SHR
        MOV       R2,?V0
        MOV       R3,?V1
        MOV       R7,#0x8
        LJMP      ?FUNC_LEAVE_PDATA
        REQUIRE P0DIR
        REQUIRE P0INP
        REQUIRE APCFG
        REQUIRE ADCCON3
        REQUIRE ADCCON1
        REQUIRE ADCH
        REQUIRE ADCL
        REQUIRE P0SEL
// 1986 }
