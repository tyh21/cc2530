//  145 
//  146 /* ★★ v44 硬件看门狗: 唯一的作用是把"无声卡死"变成"可读的报告"。
//  147  *   CC2530 (SWRU191F 手册 p.154):
//  148  *     MODE[1:0] = WDCTL[3:2]: 00=IDLE  10=看门狗模式  11=定时器模式
//  149  *     INT[1:0]  = WDCTL[1:0]: 00=~1s  01=0.25s  10=15.6ms  11=1.9ms
//  150  *     CLR[3:0]  = WDCTL[7:4]: 看门狗模式下写 0xA 后写 0x5 即喂狗
//  151  *   ★ 看门狗模式一旦使能就无法关掉, 所以只能在退出-复位前一直喂。
//  152  */

        RSEG NEAR_CODE:CODE:NOROOT(0)
//  153 void NFC_WdtArm(void)
NFC_WdtArm:
        CODE
//  154 {
        ; Saved register size: 0
        ; Auto size: 0
//  155     WDCTL = 0x00u;          /* 先回到 IDLE, 顺带把 INT 定成 00 (~1s) */
        MOV       0xc9,#0x0
//  156     WDCTL = 0x08u;          /* MODE=10 -> 看门狗模式 */
        MOV       0xc9,#0x8
//  157 }
        RET
        REQUIRE WDCTL

        RSEG NEAR_CODE:CODE:NOROOT(0)
//  158 void NFC_WdtFeed(void)
NFC_WdtFeed:
        CODE
//  159 {
        ; Saved register size: 0
        ; Auto size: 0
//  160     WDCTL = (uint8)((WDCTL & 0x0Fu) | 0xA0u);   /* CLR = 0xA */
        MOV       A,0xc9
        ANL       A,#0xf
        ORL       A,#0xa0
        MOV       0xc9,A
//  161     WDCTL = (uint8)((WDCTL & 0x0Fu) | 0x50u);   /* CLR = 0x5 */
        MOV       A,0xc9
        ANL       A,#0xf
        ORL       A,#0x50
        MOV       0xc9,A
//  162 }
        RET
        REQUIRE WDCTL
//  163 
//  164 /* 等 T1 前进 t 个 tick (自动处理 16 位回绕)
//  165  *
//  166  * ★★ v44 重大修复: 这里原先是**零保护死等**
//  167  *      do { e = read_t1(); } while ((uint16)(e - s) < t);
//  168  *   只要 T1 因为任何原因不再计数(被别的外设关掉 / 时钟源没了 / 溢出标志异常),
//  169  *   整段代码就永久卡在这个 do-while 里 —— 无任何外层救援。
//  170  *   Round 45 的"step 9 卡死"就是这个:
//  171  *     NFC_AddrScanAck 一轮 128 个地址, 每个地址 ~20 次位延时,
//  172  *     它是全固件里唯一会密集调用位延时的地方, 所以概率上先在这里炸。
//  173  *   现在加硬上限: 超时不再等, 直接返回并累计计数, 上层把计数画到屏上。
