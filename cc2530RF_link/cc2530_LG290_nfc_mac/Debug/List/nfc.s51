// C:\Users\tyh21\Desktop\cc2530\cc2530_RF_link\cc2530_LG290_nfc_mac\src\nfc.c
//    1 /**
//    2  * @file    nfc.c
//    3  * @brief   MN63Y1213 主机侧 I2C 驱动 (v11 —— 严格按原厂固件 0x7Bxx 逆向复刻)
//    4  *
//    5  * ★★★ v11: 严格按原厂固件(fw_LG290_256k.bin) 0x7B00-0x7F30 逆向结果复刻 ★★★
//    6  *
//    7  * ★ v10→v11 重大修正:
//    8  *   1. 从地址 0x54 → 0x55 (原厂 0x7DE5: MOV A,#0x55 写入 XRAM 0x1B61)
//    9  *   2. 命令层改为"直接块寻址"(EEPROM-like), 去掉命令码 0x08/0x18
//   10  *   3. 读改为两段式: 先 write_cmd 设块地址, 再 read_cmd 读数据
//   11  *   4. START 改为原厂非标准时序
//   12  *   5. 物理层时序延时改为原厂量级 (3C/78 单位)
//   13  *
//   14  * ★ 原厂 NFC 物理层映射(全部已确认):
//   15  *   0x7B48 set_slv   0x7B5F read_sda  0x7B8F write_byte
//   16  *   0x7BEE START     0x7BCC STOP
//   17  *   0x7C10 read_cmd  0x7CC7 write_cmd
//   18  *   0x7DAD batch_read 0x7E5C batch_write  0x7EED verify
//   19  *
//   20  * 原厂协议(直接块寻址, 非手册标准命令):
//   21  *   write: START(0x7BEE) -> 写地址(0xAA) -> ACK -> 块地址 -> ACK -> 数据... -> ACK -> STOP(0x7BCC 结束)
//   22  *   read:  先 write_cmd(块地址,len=0) 设地址 -> read_cmd(len) 读数据
//   23  *   结束用 STOP(0x7BCC), 第一字节是块地址, 无命令码!
//   24  *
//   25  * CPU 主频: 16MHz RCOSC (原厂 0xFE11: CLKCONCMD=0x80)
//   26  * SDA/SCL: P0.0/P0.1 推挽 (原厂 0x7D4D: P0DIR|=0x03)
//   27  * VDDEX: P2.3, 复位脉冲 5ms
//   28  *
//   29  * 诊断功能(ScopeTx/Decide9/PinDrive/BusOn 等)保留, 仅供调试, 不在 I2C 通信路径上。
//   30  */
//   31 #include "nfc.h"

