//  111 
//  112 /* ★ v23: 前向声明 —— wait_us 定义在文件后部, 但 NFC_VddAlive 等前置函数要用 */
//  113 static void wait_us(uint16 us);
//  114 
//  115 /* ===========================================================================
//  116  *                       Timer1 / 睡眠定时器 底层
//  117  * =========================================================================== */
//  118 /* 读 T1 16 位计数器。CC2530: 先读 T1CNTL 会锁存 T1CNTH, 必须 L 后 H。 */

        RSEG NEAR_CODE:CODE:NOROOT(0)
//  119 static uint16 read_t1(void)
read_t1:
        CODE
//  120 {
        ; Saved register size: 0
        ; Auto size: 0
//  121     uint8 l = T1CNTL;
        MOV       R2,0xe2+0x0
//  122     uint8 h = T1CNTH;
        MOV       A,0xe3+0x0
//  123     return (uint16)(((uint16)h << 8) | (uint16)l);
        MOV       R0,A
        MOV       R1,#0x0
        CLR       A
        XCH       A,R0
        MOV       R1,A
        MOV       A,R2
        MOV       R2,A
        MOV       R3,#0x0
        MOV       A,R0
        ORL       A,R2
        MOV       R2,A
        MOV       A,R1
        ORL       A,R3
        MOV       R3,A
        RET
        REQUIRE T1CNTL
        REQUIRE T1CNTH
//  124 }
//  125 
//  126 /* 读 32.768kHz 睡眠定时器(24 位, ST0 最低) */

        RSEG NEAR_CODE:CODE:NOROOT(0)
//  127 static uint32 st24(void)
st24:
        CODE
//  128 {
        REQUIRE ?V0
        REQUIRE ?V1
        REQUIRE ?V2
        REQUIRE ?V3
        REQUIRE ?V4
        REQUIRE ?V5
        REQUIRE ?V6
        REQUIRE ?V7
        MOV       A,#-0xd
        LCALL     ?FUNC_ENTER_PDATA
        ; Saved register size: 13
        ; Auto size: 0
//  129     uint32 v;
//  130     uint8  a, b, c;
//  131     a = ST0; b = ST1; c = ST2;
        MOV       R2,0x95+0x0
        MOV       R1,0x96+0x0
        MOV       A,0x97+0x0
//  132     v = (uint32)c;
        MOV       ?V4,A
        CLR       A
        MOV       ?V5,A
        MOV       ?V6,A
        MOV       ?V7,A
//  133     v = (v << 8) | (uint32)b;
        MOV       A,#0x8
        MOV       R0,#?V4
        LCALL     ?L_SHL
        MOV       ?V0,R1
        CLR       A
        MOV       ?V1,A
        MOV       ?V2,A
        MOV       ?V3,A
        MOV       R0,#?V4
        MOV       R1,#?V0
        LCALL     ?L_IOR
//  134     v = (v << 8) | (uint32)a;
        MOV       A,#0x8
        MOV       R0,#?V4
        LCALL     ?L_SHL
        MOV       ?V0,R2
        CLR       A
        MOV       ?V1,A
        MOV       ?V2,A
        MOV       ?V3,A
        MOV       R0,#?V4
        MOV       R1,#?V0
        LCALL     ?L_IOR
//  135     return v;
        MOV       R2,?V4
        MOV       R3,?V5
        MOV       R4,?V6
        MOV       R5,?V7
        MOV       R7,#0x8
        LJMP      ?FUNC_LEAVE_PDATA
        REQUIRE ST0
        REQUIRE ST1
        REQUIRE ST2
//  136 }
//  137 
//  138 /* ★★ v44: 地址全扫描的实时进度。写在全局是为了被 ISR / 复位后路径读到:
//  139  *   一旦卡住, 这个值就是"最后一张还没干完的活"。 */

        RSEG XDATA_Z:XDATA:NOROOT(0)
