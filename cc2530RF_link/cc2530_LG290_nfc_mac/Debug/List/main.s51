// 1344     /* ============ 第 6 屏: 上电序列 × SDA/SCL 交换 组合扫描 ================
// 1345      * 屏0 已证明: 总线电平/外部上拉/短路全部正常, 却 128 个地址 × 6 档速度
// 1346      * **零应答**。手册: SDA/SCL/NIRQ 全靠**外部上拉到 VDDEX**, 且"给 VDDEX 上电
// 1347      * 之后等 tBoot"才能访问 —— 说明芯片的串行接口是跟着 VDDEX 走的。
// 1348      * 而 v8~v16 的上电顺序是"**先**把 SDA/SCL 推挽驱动到 3.3V, **再**给 VDDEX 打
// 1349      * 高→低→高 的复位脉冲"。VDDEX=0 时用推挽压着两根线, 会经芯片的 ESD 二极管
// 1350      * 给它"偷供电", 很可能毁掉干净的上电复位 → 芯片根本不开 I2C 接口。
// 1351      * 本屏把 3 个开关全组合逐个试, 每个组合对 0x55 探"写/读"各一次:
// 1352      *   p = 1/0 : 是否发 VDDEX 复位脉冲
// 1353      *   e = 1/0 : 1=先驱动线再上 VDDEX(v8 老行为), 0=先上 VDDEX 稳定再碰线
// 1354      *   s = 0/1 : SDA/SCL 是否交换
// 1355      * 命中判据: 哪一行出现 R, 就是那一组组合对。
// 1356      * ==================================================================== */
// 1357     {
// 1358         uint8 p_set[8], e_set[8], s_set[8], k0[8], k1[8];
// 1359         p_set[0]=1u; e_set[0]=1u; s_set[0]=0u;
// 1360         p_set[1]=0u; e_set[1]=1u; s_set[1]=0u;
// 1361         p_set[2]=1u; e_set[2]=0u; s_set[2]=0u;
