//  108 
//  109 /* ★★ v24 更正 (查 TI CC253x 用户手册 SWRU191F §7.4 确认):
//  110  *   CLKCONCMD / CLKCONSTA 的 **bit6** 才是系统主时钟选择位, 不是 bit7!
//  111  *     bit7  OSC32K  : 0 = 32kHz XOSC(晶体), 1 = 32kHz RCOSC   (复位=1)
//  112  *     bit6  OSC     : 0 = 32MHz XOSC(晶体), 1 = 16MHz RCOSC    (复位=1)
//  113  *     bit5:3 TICKSPD: 定时器 tick 速率 (复位=001 → 16MHz)
//  114  *     bit2:0 CLKSPD : CPU 时钟      (复位=001 → 16MHz)
//  115  *   ⇒ 上一版(v23)我误以为 OSC 是 bit7 而"修正"成 ~0x80 —— **那是错的**,
//  116  *     反而清掉了 OSC32K(把 32kHz 晶体源弄丢)。现已改回 bit6。
//  117  *
//  118  *   原代码 `&=~0x40` / `while(CLKCONSTA&0x40)` / `&=~0x47` 一直是**对的**:
//  119  *     清 bit6 → 选 32MHz XOSC; 等 CLKCONSTA.6 变 0 → 32MHz 已稳定;
//  120  *     再清 TICKSPD/CLKSPD 低 3 位 → 定时器与 CPU 都跑 32MHz。
//  121  *   ★ 唯一保留的改进: 明确不动 bit7(OSC32K), 让 32kHz 源保持芯片默认(晶体),
//  122  *     这样睡眠定时器(ST)才有可能按 32.768kHz 走。 */

        RSEG NEAR_CODE:CODE:NOROOT(0)
//  123 static void clock_init(void)
clock_init:
        CODE
//  124 {
        ; Saved register size: 0
        ; Auto size: 0
//  125     CLKCONCMD &= (uint8)~0x40u;      /* OSC=0 -> 系统主时钟选 32MHz XOSC */
        ANL       0xc6,#0xbf
//  126     while (CLKCONSTA & 0x40u) { ; }  /* 等 CLKCONSTA.6 变 0: 32MHz 已稳定 */
??clock_init_0:
        MOV       A,0x9e
        MOV       C,0xE0 /* A   */.6
        JC        ??clock_init_0
//  127     CLKCONCMD &= (uint8)~0x47u;      /* TICKSPD=000, CLKSPD=000 (都跑 32MHz) */
        ANL       0xc6,#0xb8
//  128 }
        RET
        REQUIRE CLKCONCMD
        REQUIRE CLKCONSTA
