// 1402 
// 1403 /* ===========================================================================
// 1404  * ★★★★ v30: RF 场实时观测模式 (只在 V30_RFWATCH 定义时编译)
// 1405  * ---------------------------------------------------------------------------
// 1406  * 假设(用户提出, 合理): MN63Y1213 是**双接口**芯片 —— RF 接口(线圈) + I2C 接口。
// 1407  *   RF 侧有整流器, 手机 NFC 场会经线圈给芯片取电, 可能因此把芯片供起来,
// 1408  *   于是 I2C 侧就能应答。本模式不休眠地循环探测, 结果实时打串口,
// 1409  *   用户把手机贴上线圈的瞬间就能看到变化。
// 1410  *
// 1411  * 每轮 (~0.2s):
// 1412  *   1. P2.3(VDDEX) 保持驱高(不来回开关, 不打扰 RF 侧可能建立的电位)
// 1413  *   2. NFC_BusRecover() 踢回空闲
// 1414  *   3. 探 0x55(真地址) 与 0x6B(必然不存在的对照地址)
// 1415  *   4. 打: 轮次 kind55 kind6B s5 两线电平 P2 NIRQ
// 1416  *   5. ★ 若 k55 != k6B ⇒ 总线"活了"(真器件在响应) —— 这是关键判据!
// 1417  * =========================================================================== */
// 1418 #if defined(V30_RFWATCH) && (V30_RFWATCH != 0) && !(defined(V40_EPD) && (V40_EPD != 0))
// 1419 /* ★★★★ v30e: 顺序实验 —— "RF 场先到 -> 再开 VDDEX" ★★★★
// 1420  *
// 1421  * ★★ 本轮来自用户的指正(核心思路):
// 1422  *   之前所有实验的**顺序反了** —— 不能先拉高 P2.3。
// 1423  *   芯片在 RF-only(场取电)模式下, 会用内部电路把 VDDEX 节点**牵制**住;
// 1424  *   此时 MCU 抢着推挽拉高, 两股力量顶牛, 节点被钉在 ~0.6V, 于是既供不上电、
// 1425  *   也把 I2C 侧拖死。正确顺序应该是:
// 1426  *
// 1427  *     RF 场出现 -> 芯片检测到 -> [芯片通知主机 NIRQ] -> **主机才拉 P2.3**
// 1428  *               -> VDDEX 正常升到 3.2V -> 芯片进 Serial 模式 -> I2C 可用
// 1429  *
// 1430  * ★ 但 v30b/c/d 全程实测数据说话: **NIRQ 从未拉低过 (nLo 恒等于 0)**。
// 1431  *   => 用户说的"通知主机"这一环, 在这块板 / 这种模式下**确实不存在**。
// 1432  *   => 所以本固件退一步, 改用 **RF 场在 P2.3 浮空节点上耦合出的电位抬升**
// 1433  *      本身当触发源(v30b/c/d 已反复证明: 手机贴上 -> P23 读数=1、
// 1434  *      line -> 0x03, 且能稳定维持几十秒)。
// 1435  *
// 1436  * ★ 本固件做两组对比, 一轮跑完就能定死结论:
// 1437  *     [A] 对照组   上电就硬拉 P2.3(不等 RF) -> 读回引脚真实电平 + 试 I2C
// 1438  *     [B] 实验组   浮空监测, **检测到 RF 场之后才**拉 P2.3 -> 读回 + 试 I2C
// 1439  *
// 1440  * ★★ 关键诊断手法(不需要万用表):
// 1441  *     CC2530 在**推挽输出高**的状态下读 P2 寄存器, 得到的是**引脚真实电平**:
// 1442  *       读到 1  -> 引脚确实 >= VIH(约 2.3V) -> VDDEX 真供上去了
// 1443  *       读到 0  -> 引脚被外部钉在 <2.3V     -> 存在牵制 / 钳位
// 1444  *     这一位就足以判定 VDDEX 到底有没有真正起来。
// 1445  *
// 1446  * 打印字段:
// 1447  *   [RFW] n / p23 / nirq / line / nHi / nLo / SEQ
// 1448  *   >>> SEQ#k <<<            第 k 轮序列
// 1449  *   P2.3 读回 = x            ★ 关键: 1=供上, 0=被钉低
// 1450  *   Decide9 k / s5           0 REAL 1 LATE 2 NONE 3 STUCK
// 1451  *   ReadMem[i] rm=           0=OK(并打印 blk) 1=NOACK
// 1452  */
// 1453 
// 1454 /* P2.3 放开成三态输入 —— 用于浮空观测 RF 场耦合 */
// 1455 static void v30e_p23_float(void)
// 1456 {
// 1457     P2SEL &= (uint8)~0x02u;   /* P2SEL.1 = P2.3 功能位(0=GPIO) */
// 1458     P2INP |= 0x08u;           /* 三态: 不内拉, 只看外部 */
// 1459     P2DIR &= (uint8)~0x08u;   /* 输入 */
// 1460 }
// 1461 
// 1462 /* P2.3 推挽拉高 */
// 1463 static void v30e_p23_drive_hi(void)
// 1464 {
// 1465     P2SEL &= (uint8)~0x02u;
// 1466     P2DIR |= 0x08u;
// 1467     P2    |= 0x08u;
// 1468 }
// 1469 
// 1470 /* SDA/SCL 全放开(三态不内拉) —— 观测时不打扰芯片 */
