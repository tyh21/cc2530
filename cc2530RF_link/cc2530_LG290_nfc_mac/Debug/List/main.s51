//   51 /* ============================ 串口 =======================================
//   52  * ★ v22: 改用与 LG213 板完全一致的调试串口 —— USART1 Alt2, TX=P1.6 RX=P1.7,
//   53  *   115200 8N1 (32MHz)。
//   54  *   依据: 213 工程 src/uart0.c 实测通过; 且原厂 LG290 固件本身也是
//   55  *   `ORL PERCFG,#0x02` (U1CFG=1) + `ORL P1SEL,#0xC0` = P1.6/P1.7 调试串口
//   56  *   (见 cc2530_LG213/nfc_analysis.md 第 260 行), 属"回到原厂做法"。
//   57  *   引脚零冲突: 本板 NFC=SDA P0.1/SCL P0.0/PWR P2.3; EPD=P0.2~P0.7,P1.1,P1.2。
//   58  *   P1.6/P1.7 全空闲。
//   59  *   接线: USB-TTL RX <- 板 P1.6(TX); GND 共地即可(只发不收)。
//   60  */

        RSEG NEAR_CODE:CODE:NOROOT(0)
//   61 static void uart_init(void)
uart_init:
        CODE
//   62 {
        ; Saved register size: 0
        ; Auto size: 0
//   63     PERCFG |= 0x02u;          /* U1CFG=1: USART1 -> Alt2 (TX=P1.6, RX=P1.7) */
        ORL       0xf1,#0x2
//   64     P1SEL  |= 0xC0u;          /* P1.6/P1.7 = 外设功能 */
        ORL       0xf4,#0xc0
//   65     P2SEL  &= (uint8)~0x20u;  /* PRI2P1=0: USART1 优先于 Timer3 (TI 官方写法) */
        ANL       0xf5,#0xdf
//   66 
//   67     U1CSR   = 0x80u;          /* MODE=1: UART */
        MOV       0xf8,#-0x80
//   68     U1UCR   = 0x02u;          /* FLUSH; 8 数据位, 1 停止位, 无校验 */
        MOV       0xfb,#0x2
//   69     U1GCR   = 11u;            /* BAUD_E */
        MOV       0xfc,#0xb
//   70     U1BAUD  = 216u;           /* BAUD_M -> 115200 @32MHz (与 213 一致) */
        MOV       0xfa,#-0x28
//   71     UTX1IF  = 0;
        CLR       0xe8.2
//   72 }
        RET
        REQUIRE PERCFG
        REQUIRE P1SEL
        REQUIRE P2SEL
        REQUIRE _A_U1CSR
        REQUIRE U1UCR
        REQUIRE U1GCR
        REQUIRE U1BAUD
        REQUIRE _A_IRCON2
