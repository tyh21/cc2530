// 1474     P0INP |= 0x03u;
// 1475     P0DIR &= (uint8)~0x03u;
// 1476     P2INP |= 0x20u;           /* PDUP0=1 -> Port0 三态 */
// 1477     P0IEN &= (uint8)~0x03u;
// 1478 }
