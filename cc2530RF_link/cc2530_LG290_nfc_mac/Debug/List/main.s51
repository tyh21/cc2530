// static __near_func __pdata_reentrant void w45_p23_float(void)
w45_p23_float:
        CODE
        ; Saved register size: 0
        ; Auto size: 0
        ANL       0xf5,#0xfd
        ORL       0xf7,#0x8
        ANL       0xff,#0xf7
        RET
        REQUIRE P2SEL
        REQUIRE P2INP
        REQUIRE P2DIR

        RSEG NEAR_CODE:CODE:NOROOT(0)
// static __near_func __pdata_reentrant void w45_p23_hi(void)
w45_p23_hi:
        CODE
        ; Saved register size: 0
        ; Auto size: 0
        ANL       0xf5,#0xfd
        ORL       0xf7,#0x8
        ORL       0xff,#0x8
