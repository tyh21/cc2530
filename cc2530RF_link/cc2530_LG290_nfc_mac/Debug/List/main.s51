// 1272     /* ============ 第 5 屏: UNLOCK —— 解除只读锁 =========================
// 1273      * 手册 §3.3.1: 两把锁都是 **FeRAM 字节, 非 OTP**, 且 I2C 主机可写:
// 1274      *   RORF   (系统区 0x01F0..0x01F3): RF 模式读/写 vs 只读 (1=只读)
// 1275      *   ROSI   (系统区 0x01F4..0x01F7): **串行(I2C)模式**读/写 vs 只读 (1=只读)
// 1276      *   AIB[10](block0 字节10)        : Type3 NDEF 访问标志 (0x00=可写 0xFF=只读)
// 1277      * 做法: 读-改-写整块(保留 SECURITY 0x01F8..0x01FF 不动), 再读回验证。
// 1278      * ★ 注意: I2C 若仍 NOACK(看屏0), 本屏会显示失败 —— 先解决总线才能解锁。
// 1279      * ==================================================================== */
// 1280     {
// 1281         uint8 uslv = (slv != 0u) ? slv : 0x55u;
// 1282 
// 1283         power_cycle(50u);
// 1284 
// 1285         /* 1) AIB block0 字节10 -> 0x00 (允许 RF 写 NDEF) */
// 1286         g_un_rd1 = NFC_ReadMem(uslv, 0x0000u, 16u, g_aib2, 0);
// 1287         if (g_un_rd1 == NFC_OK) {
// 1288             g_aib2[10] = 0x00u;
// 1289             g_un_wr1 = NFC_WriteMem(uslv, 0x0000u, g_aib2, 16u, 0);
// 1290         } else {
// 1291             g_un_wr1 = NFC_ERR_NOACK;
// 1292         }
// 1293 
// 1294         /* 2) RORF(1F0..1F3) + ROSI(1F4..1F7) -> 0x00 (清两块只读) */
// 1295         g_un_rd2 = NFC_ReadMem(uslv, 0x01F0u, 16u, g_sys, 0);
// 1296         if (g_un_rd2 == NFC_OK) {
// 1297             for (i = 0u; i < 8u; i++) { g_sys[i] = 0x00u; }
// 1298             g_un_wr2 = NFC_WriteMem(uslv, 0x01F0u, g_sys, 16u, 0);
// 1299         } else {
// 1300             g_un_wr2 = NFC_ERR_NOACK;
// 1301         }
// 1302 
// 1303         /* 3) 读回验证 */
// 1304         g_un_rd1 = NFC_ReadMem(uslv, 0x0000u, 16u, g_aib2, 0);
// 1305         g_un_rd2 = NFC_ReadMem(uslv, 0x01F4u, 4u, g_rosi, 0);
// 1306         NFC_PowerOff();
// 1307 
