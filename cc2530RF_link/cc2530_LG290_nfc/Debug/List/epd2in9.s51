        RSEG NEAR_CODE:CODE:NOROOT(0)
//   93 void EPD_GpioInit(void)
EPD_GpioInit:
        CODE
//   94 {
        ; Saved register size: 0
        ; Auto size: 0
//   95     /* P0.2/3/4/5 设为通用 IO (DC/SDI/CS/SCLK), P0.7 = PWR */
//   96     P0SEL &= ~0xBC;
        ANL       0xf3,#0x43
//   97     P0DIR |=  0xBC;                    /* P0.2,3,4,5,7 输出 */
        ORL       0xfd,#0xbc
//   98 
//   99     /* P1.1 输出 (RST), P1.2 输入 (BUSY) */
//  100     P1SEL &= ~0x06;
        ANL       0xf4,#0xf9
//  101     P1DIR |=  0x02;
        ORL       0xfe,#0x2
//  102     P1DIR &= ~0x04;
        ANL       0xfe,#0xfb
//  103 
//  104     /* 初始电平: 信号空闲态, 电源先关 */
//  105     EPD_CS   = 1;
        SETB      0x80.4
//  106     EPD_DC   = 1;
        SETB      0x80.2
//  107     EPD_SCLK = 0;
        CLR       0x80.5
//  108     EPD_SDI  = 0;
        CLR       0x80.3
//  109     EPD_RST  = 1;
        SETB      0x90.1
//  110     EPD_PWR  = EPD_PWR_OFF_LVL;        /* 由 EPD_PowerOn() 上电 */
        CLR       0x80.7
//  111 }
        RET
        REQUIRE P0SEL
        REQUIRE P0DIR
        REQUIRE P1SEL
        REQUIRE P1DIR
        REQUIRE _A_P0
        REQUIRE _A_P1
