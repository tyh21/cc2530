//   68 static void EPD_DelayMS(uint16 ms)
EPD_DelayMS:
        CODE
//   69 {
        ; Saved register size: 0
        ; Auto size: 0
//   70     uint16 i, j;
//   71     for (i = 0; i < ms; i++)
        MOV       R4,#0x0
        MOV       R5,#0x0
        SJMP      ??EPD_DelayMS_0
//   72         for (j = 0; j < 535; j++);
??EPD_DelayMS_1:
        INC       R0
        MOV       A,R0
        JNZ       ??EPD_DelayMS_2
        INC       R1
??EPD_DelayMS_2:
        CLR       C
        MOV       A,R0
        SUBB      A,#0x17
        MOV       A,R1
        SUBB      A,#0x2
        JC        ??EPD_DelayMS_1
        INC       R4
        MOV       A,R4
        JNZ       ??EPD_DelayMS_0
        INC       R5
??EPD_DelayMS_0:
        CLR       C
        MOV       A,R4
        SUBB      A,R2
        MOV       A,R5
        SUBB      A,R3
        JNC       ??EPD_DelayMS_3
        MOV       R0,#0x0
        MOV       R1,#0x0
        SJMP      ??EPD_DelayMS_2
//   73 }
??EPD_DelayMS_3:
        RET
//   74 
//   75 /* ---------------- 电源控制: P0.7 -> MOS 管开关 (高电平上电) ----------------
//   76  * 实测教训: 深睡 (0x07 0xA5) 后热复位唤不醒 SSD1680, 必须电源循环。
//   77  * 所以每次 EPD_Init 都做完整的 断电->上电 冷启动序列, 不做任何"已上电"捷径。
//   78  */

        RSEG NEAR_CODE:CODE:NOROOT(0)
//   79 void EPD_PowerOn(void)
EPD_PowerOn:
        CODE
//   80 {
        ; Saved register size: 0
        ; Auto size: 0
//   81     EPD_PWR = EPD_PWR_OFF_LVL;         /* 强制断电 */
        CLR       0x80.7
//   82     EPD_DelayMS(200);                  /* 放电: 让控制器彻底掉电复位 */
        ; Setup parameters for call to function EPD_DelayMS
        MOV       R2,#-0x38
        MOV       R3,#0x0
        LCALL     EPD_DelayMS
//   83     EPD_PWR = EPD_PWR_ON_LVL;          /* 上电 (原固件 0x11735) */
        SETB      0x80.7
//   84     EPD_DelayMS(100);                  /* 供电稳定 */
        ; Setup parameters for call to function EPD_DelayMS
        MOV       R2,#0x64
        MOV       R3,#0x0
        LCALL     EPD_DelayMS
//   85 }
        RET
        REQUIRE _A_P0
//   86 

        RSEG NEAR_CODE:CODE:NOROOT(0)
//   87 void EPD_PowerOff(void)
EPD_PowerOff:
        CODE
//   88 {
        ; Saved register size: 0
        ; Auto size: 0
//   89     EPD_PWR = EPD_PWR_OFF_LVL;         /* 原固件 0x11766 休眠断电 */
        CLR       0x80.7
//   90 }
        RET
        REQUIRE _A_P0
//   91 
