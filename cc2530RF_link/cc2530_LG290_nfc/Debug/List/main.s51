// C:\Users\tyh21\Desktop\cc2530\cc2530_RF_link\cc2530_LG290_nfc\src\main.c
//    1 /**
//    2  * @file    main.c
//    3  * @brief   LG290 板 MN63Y1213 —— v5 诊断固件
//    4  *
//    5  * ============================================================================
//    6  * v4 四屏读完之后的结论(也是 v5 要证伪/证实的):
//    7  *   · 屏1 "kHz=251" 是**显示 bug**: NFC_GetBitUs100() 把 ns 除了 100(应该除 10),
//    8  *     真实位周期一直是 40us = 25kHz —— 正好在手册 5.2.1 允许的 20~100kHz 之内。
//    9  *     所以"跑太快芯片不认"这条可以划掉。
//   10  *   · 屏1 "ns=061" ⇒ T1 每 tick 61ns(≈16.4MHz) 而不是 32MHz。CC2530 复位后
//   11  *     CLKCONCMD.TICKSPD 默认不是 /1。v5 显式设成 /1。
//   12  *   · 屏2(示波)与屏3(单发 0x54/0x55)都说"没有 ACK", 屏4(扫 128)却说"128 个全 ACK"
//   13  *     —— 自相矛盾。v5 用**同一条探测代码**分别以 rd=0 / rd=1 各扫一遍, 把这个矛盾钉死。
//   14  *   · 手册 2.3 + Figure 2-3: SDA/SCL/NIRQ 要 **3.3k 上拉到 VDDEX**, VDDEX 挂电容。
//   15  *     而 v4 在 VDDEX 还没抬起来之前就用 MCU 内部上拉把两条线拉到 3.3V —— 电流经芯片
//   16  *     ESD 二极管灌进 VDDEX 节点, 芯片"半个上电", 上电复位不干净。v5 改成: 先三态、
//   17  *     再抬 VDDEX、等 tBoot、最后才碰两条线。
//   18  *
//   19  * v5 五屏(每屏全刷, 停 5 秒; 第 5 屏要拿手机贴线圈):
//   20  *   1 TIME&PWR  T1 时间基准(修正后的 us/kHz) + 外部上拉在不在 + 断电倒灌 + VDDEX 去耦
//   21  *   2 SCOPE     0x54 的 R/W 两种真波形画上屏, 第 9 位是什么就看图
//   22  *   3 tBOOT     抬 VDDEX 后 2/10/50/200/1000ms 各探一次 0x54; 再连探 20 次
//   23  *   4 SCAN      rd0 与 rd1 各扫 0x00..0x7F, 直接对比(破"128 全 ACK")
//   24  *   5 RF ALIVE  拿手机贴线圈, 看 NIRQ 会不会动 —— 证明 VDDEX 真喂到芯片、芯片活着
//   25  *
//   26  * ★ 铁律: VDDEX = P2.3。所有测量在 VDDEX ON 时做完, 画屏前必须 NFC_PowerOff()。
//   27  * ============================================================================
//   28  */
